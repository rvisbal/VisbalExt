{
  "name": "visbal-ext",
  "displayName": "Visbal Extension",
  "version": "1.2.2",
  "publisher": "visbal",
  "icon": "media/icon.png",
  "description": "A Visual Studio Code extension for Salesforce development with enhanced test execution and log analysis capabilities",
  "author": {
    "name": "Visbal"
  },
  "categories": [
    "Other",
    "Testing",
    "Debuggers"
  ],
  "keywords": [
    "salesforce",
    "apex",
    "testing",
    "logs",
    "debug"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/visbal-ext.git"
  },
  "scripts": {
    "clean": "if exist dist rd /s /q dist && if exist out rd /s /q out && if exist *.vsix del *.vsix",
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --watch --config webpack.config.js",
    "package": "vsce package",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "prepackage": "npm run clean && npm run build"
  },
  "engines": {
    "vscode": "^1.87.0"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "debug": [],
      "panel": [
        {
          "id": "visbal-orgs-container",
          "title": "Orgs",
          "icon": "$(organization)"
        },
        {
          "id": "visbal-log-container",
          "title": "Apex Log",
          "icon": "$(notebook)"
        },
        {
          "id": "visbal-soql-container",
          "title": "SOQL",
          "icon": "$(database)"
        },
        {
          "id": "visbal-apex-container",
          "title": "Execute Apex",
          "icon": "$(beaker)"
        },
        {
          "id": "visbal-traction-container",
          "title": "Traction",
          "icon": "$(rocket)"
        },
        {
          "id": "visbal-json-container",
          "title": "JSON Viewer",
          "icon": "$(json)"
        }
      ],
      "activitybar": [
        {
          "id": "visbal-test-container",
          "title": "Visbal Test",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "debug": [
        {
          "type": "webview",
          "id": "visbal-test-results",
          "name": "Test Results",
          "when": "inDebugMode"
        }
      ],
      "visbal-test-container": [
        {
          "id": "testClassExplorerView",
          "name": "Test Classes",
          "type": "webview"
        },
        {
          "id": "testRunResults",
          "name": "Running Tasks",
          "type": "tree",
          "visibility": "visible",
          "hideMenus": true
        },
        {
          "id": "visbal-test-summary",
          "name": "Test Summary",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "visbal-log-container": [
        {
          "type": "webview",
          "id": "visbal-log",
          "name": "Log Analyzer"
        }
      ],
      "visbal-soql-container": [
        {
          "type": "webview",
          "id": "visbal-soql",
          "name": "SOQL Query"
        }
      ],
      "visbal-orgs-container": [
        {
          "type": "webview",
          "id": "visbal-orgs",
          "name": "Salesforce Orgs"
        }
      ],
      "visbal-apex-container": [
        {
          "type": "webview",
          "id": "visbal-apex",
          "name": "Sample Panel"
        }
      ],
      "visbal-traction-container": [
        {
          "type": "webview",
          "id": "visbal-traction",
          "name": "Traction Panel"
        }
      ],
      "visbal-json-container": [
        {
          "type": "webview",
          "id": "visbal-json-viewer",
          "name": "JSON Viewer"
        }
      ]
    },
    "commands": [
      {
        "command": "visbal.clearConsole",
        "title": "Clear Console",
        "category": "Visbal",
        "icon": "$(clear-all)"
      },
      {
        "command": "visbal-ext.refreshVisbalLog",
        "title": "Refresh Visbal Log",
        "category": "Visbal",
        "icon": "$(refresh)"
      },
      {
        "command": "visbal.fetchLogsViaRestApi",
        "title": "Fetch Salesforce Logs via REST API",
        "icon": "$(cloud-download)"
      },
      {
        "command": "visbal.executeApexRest",
        "title": "Execute Salesforce Apex REST Endpoint",
        "icon": "$(play)"
      },
      {
        "command": "visbal-ext.showVisbalLog",
        "title": "Show Visbal Log",
        "category": "Visbal"
      },
      {
        "command": "visbal-ext.showVisbalSoql",
        "title": "Show Visbal SOQL",
        "category": "Visbal"
      },
      {
        "command": "visbal-ext.showVisbalSample",
        "title": "Show Visbal Apex",
        "category": "Visbal"
      },
      {
        "command": "visbal-ext.showVisbalTraction",
        "title": "Show Traction Tab",
        "category": "Visbal"
      },
      {
        "command": "visbal-ext.showDebugConsole",
        "title": "Show Debug Console",
        "category": "Visbal Debug"
      },
      {
        "command": "visbal-ext.showTestResults",
        "title": "Show Test Results",
        "category": "Visbal Debug"
      },
      {
        "command": "visbal-ext.showLogSummary",
        "title": "Show Log Summary",
        "category": "Visbal",
        "icon": "$(preview)"
      },
      {
        "command": "visbal-ext.rerunSelectedTests",
        "title": "Rerun Selected Tests",
        "category": "Visbal",
        "icon": "$(refresh)"
      },
      {
        "command": "visbal-ext.rerunAllTests",
        "title": "Rerun All Tests",
        "category": "Visbal",
        "icon": "$(refresh)"
      },
      {
        "command": "visbal-ext.rerunFailedTests",
        "title": "Rerun Failed Tests",
        "category": "Visbal",
        "icon": "$(debug-restart)"
      },
      {
        "command": "visbal-ext.showGitHistoryForSelection",
        "title": "V: Show Git History for Selection",
        "category": "Visbal",
        "icon": "$(git-commit)"
      },
      {
        "command": "visbal-ext.showGitHistoryForSelectionAlternative",
        "title": "V: Show Git History List (Click to Diff)",
        "category": "Visbal",
        "icon": "$(diff)"
      },
      {
        "command": "visbal-ext.showGitHistoryForFile",
        "title": "V: Show Git History for File",
        "category": "Visbal",
        "icon": "$(history)"
      },
      {
        "command": "visbal-ext.selectTestMethod",
        "title": "Select Test Method Selection",
        "category": "Visbal"
      },
      {
        "command": "visbal-ext.showOutput",
        "title": "Show Visbal Extension Output",
        "category": "Visbal",
        "icon": "$(output)"
      },
      {
        "command": "visbal-ext.navigateToSelectedDefinition",
        "title": "V: Go to Selected Definition",
        "category": "Visbal",
        "icon": "$(go-to-file)"
      },
      {
        "command": "visbal-ext.showLogFilterManager",
        "title": "Show Log Filter Manager",
        "category": "Visbal",
        "icon": "$(filter)"
      },
      {
        "command": "visbal-ext.createLogFilter",
        "title": "Create Log Filter",
        "category": "Visbal",
        "icon": "$(add)"
      },
      {
        "command": "visbal-ext.applyLogFilter",
        "title": "Apply Log Filter to Current Log",
        "category": "Visbal",
        "icon": "$(filter-filled)"
      },
      {
        "command": "visbal-ext.showJsonViewer",
        "title": "Show JSON Viewer",
        "category": "Visbal",
        "icon": "$(json)"
      },
      {
        "command": "visbal-ext.openJsonInViewer",
        "title": "Open in JSON Viewer",
        "category": "Visbal",
        "icon": "$(open-preview)"
      },
      {
        "command": "visbal-ext.openTestFile",
        "title": "Open Test File",
        "category": "Visbal",
        "icon": "$(go-to-file)"
      },
      {
        "command": "visbal-ext.viewTestLog",
        "title": "View Test Log",
        "category": "Visbal",
        "icon": "$(output)"
      },
      {
        "command": "visbal-ext.testClassExplorerView.runTest",
        "title": "Run Test",
        "category": "Visbal",
        "icon": "$(play)"
      },
      {
        "command": "visbal-ext.testClassExplorerView.runSelectedTests",
        "title": "Run Selected Tests",
        "category": "Visbal",
        "icon": "$(play-circle)"
      },
      {
        "command": "visbal-ext.validateJson",
        "title": "Validate JSON",
        "category": "Visbal",
        "icon": "$(check)"
      },
      {
        "command": "visbal-ext.formatJson",
        "title": "Format JSON",
        "category": "Visbal",
        "icon": "$(code)"
      },
      {
        "command": "visbal-ext.minifyJson",
        "title": "Minify JSON",
        "category": "Visbal",
        "icon": "$(collapse-all)"
      },
      {
        "command": "visbal-ext.convertJsonToYaml",
        "title": "Convert JSON to YAML",
        "category": "Visbal",
        "icon": "$(symbol-method)"
      },
      {
        "command": "visbal-ext.generateJsonSchema",
        "title": "Generate JSON Schema",
        "category": "Visbal",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "visbal-ext.clearRunningTests",
        "title": "Clear Running Test States",
        "category": "Visbal",
        "icon": "$(clear-all)"
      },
      {
        "command": "visbal-ext.exportTestResults",
        "title": "Export Test Results",
        "category": "Visbal",
        "icon": "$(save-as)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visbal.clearConsole",
          "group": "navigation"
        },
        {
          "command": "visbal-ext.rerunAllTests",
          "when": "view == testRunResults",
          "group": "navigation@1"
        },
        {
          "command": "visbal-ext.rerunFailedTests",
          "when": "view == testRunResults",
          "group": "navigation@2"
        },
        {
          "command": "visbal-ext.clearRunningTests",
          "when": "view == testRunResults",
          "group": "navigation@3"
        },
        {
          "command": "visbal-ext.exportTestResults",
          "when": "view == testRunResults",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "visbal-ext.showLogFilterManager",
          "when": "resourceExtname == .log",
          "group": "navigation"
        },
        {
          "command": "visbal-ext.applyLogFilter",
          "when": "resourceExtname == .log",
          "group": "navigation"
        },
        {
          "command": "visbal-ext.openJsonInViewer",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "visbal-ext.validateJson",
          "when": "resourceExtname == .json",
          "group": "navigation"
        },
        {
          "command": "visbal-ext.formatJson",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "visbal-ext.showGitHistoryForSelection",
          "when": "editorHasSelection && !isInUntitledFile && config.visbal.gitHistory.view != 'IDE'",
          "group": "1_visbal"
        },
        {
          "command": "visbal-ext.showGitHistoryForSelectionAlternative",
          "when": "editorTextFocus && !isInUntitledFile && config.visbal.gitHistory.view == 'IDE'",
          "group": "1_visbal"
        },
        {
          "command": "visbal-ext.showGitHistoryForFile",
          "when": "!isInUntitledFile",
          "group": "1_visbal"
        },
        {
          "command": "visbal-ext.navigateToSelectedDefinition",
          "when": "editorTextFocus",
          "group": "1_visbal"
        },
        {
          "command": "visbal-ext.openJsonInViewer",
          "when": "resourceExtname == .json",
          "group": "2_json"
        },
        {
          "command": "visbal-ext.validateJson",
          "when": "resourceExtname == .json",
          "group": "2_json"
        },
        {
          "command": "visbal-ext.formatJson",
          "when": "resourceExtname == .json",
          "group": "2_json"
        },
        {
          "command": "visbal-ext.minifyJson",
          "when": "resourceExtname == .json",
          "group": "2_json"
        },
        {
          "command": "visbal-ext.convertJsonToYaml",
          "when": "resourceExtname == .json",
          "group": "2_json"
        },
        {
          "command": "visbal-ext.generateJsonSchema",
          "when": "resourceExtname == .json",
          "group": "2_json"
        }
      ],
      "explorer/context": [
        {
          "command": "visbal-ext.showGitHistoryForFile",
          "group": "1_visbal"
        },
        {
          "command": "visbal-ext.openJsonInViewer",
          "when": "resourceExtname == .json",
          "group": "2_json"
        }
      ],
      "tab/context": [
        {
          "command": "visbal-ext.showGitHistoryForFile",
          "group": "1_visbal"
        }
      ]
    },
    "configuration": {
      "title": "Visbal Extension",
      "properties": {
        "visbal.modules.testExplorer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Test Explorer module"
        },
        "visbal.modules.logAnalyzer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Log Analyzer module"
        },
        "visbal.modules.soqlQuery.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the SOQL Query module"
        },
        "visbal.modules.samplePanel.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Sample Panel module"
        },
        "visbal.modules.orgs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Orgs module"
        },
        "visbal.modules.traction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Traction module"
        },
        "visbal.logging.saveToFile": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable saving logs and errors to a file."
        },
        "visbal.logging.displayInConsole": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable displaying logs and errors in the console."
        },
        "visbal.logging.deleteErrorLogsOlderThan": {
          "type": "number",
          "default": 1,
          "description": "Delete error logs older than this number of days"
        },
        "visbal.logging.debugMaxLength": {
          "type": "number",
          "default": 250,
          "description": "Debug Max Length"
        },
        "visbal.logging.debugFileMaxSize": {
          "type": "number",
          "default": 2097152,
          "description": "Debug File Max Size in Bytes"
        },
        "visbal.apexTest.downloadTestLogOnExecution": {
          "type": "boolean",
          "default": false,
          "description": "Enable/disable downloading test log on execution"
        },
        "visbal.apexTest.manualExecution": {
          "type": "boolean",
          "default": false,
          "description": "Enable/disable custom handling of test execution"
        },
        "visbal.selectedTests": {
          "type": "object",
          "default": {
            "methods": {}
          },
          "description": "Selected test methods for tracking failed tests"
        },
        "visbal.gitHistory.view": {
          "type": "string",
          "default": "webview",
          "enum": ["panel", "webview", "IDE"],
          "description": "Choose the display mode for Git History: 'panel' for a separate panel, 'webview' for the classic view."
        },
        "visbal.output.showOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Show the Visbal Extension output channel when the extension activates. Set to false to prevent it from becoming the default output tab."
        },
        "visbal.logFilter.autoApplyBuiltInFilters": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply built-in filters when opening log files"
        },
        "visbal.logFilter.maxFilterExecutionTime": {
          "type": "number",
          "default": 5000,
          "description": "Maximum execution time for filters in milliseconds"
        },
        "visbal.logFilter.showFilterPanelByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Show the filter panel by default in log views"
        },
        "visbal.jsonViewer.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open JSON files in the JSON viewer when selected"
        },
        "visbal.jsonViewer.collapseLevel": {
          "type": "number",
          "default": 2,
          "description": "Default collapse level for JSON objects (0 = fully expanded)"
        },
        "visbal.jsonViewer.showObjectStats": {
          "type": "boolean",
          "default": true,
          "description": "Show statistics about JSON objects (object count, array count, etc.)"
        },
        "visbal.modules.jsonViewer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the JSON Viewer module"
        }
      }
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.26.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "sharp": "^0.33.5",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.3.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@salesforce/core": "^6.5.2",
    "@vscode/codicons": "^0.0.35",
    "axios": "^1.6.7",
    "follow-redirects": "^1.15.6",
    "form-data": "^4.0.2",
    "highlight.js": "^11.11.1",
    "jsforce": "^1.11.1"
  },
  "resolutions": {
    "@vscode/codicons": "^0.0.35",
    "follow-redirects": "^1.15.6"
  }
}
