# Build and temp files
out/
node_modules/@types/

# Exclude ALL zip and backup files  
*.vsix
*.zip
*.bak
*.bak.*
.bak/
.bak.zip

# SFDX files (these are huge and not needed in the extension)
.sfdx/
.sf/

# Debug and cache files - exclude entire .visbal directory
.visbal/
*.log

# Development files
src/**/*.test.ts
tests/
__mocks__/
jest.config.js
webpack.config.js
tsconfig.json
.cursorrules
cursor.rules.json

# Git and IDE files
.git/
.gitignore
.vscode/
.cursor/

# Documentation (keep only essential)
Screenshot*.png
README-SALESFORCE-API.md

# Source maps (these are large and not needed in production)
**/*.map
**/*.js.map

# Backup files
*.bak
.bak.*

# Package artifacts
package-lock.json